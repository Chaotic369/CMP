{
  "manifest_version": 3,
  "name": "CMP",
  "version": "1.0.0",
  "description": "CMP - Sovereign IDE Extension",
  "permissions": [
    "sidePanel",
    "windows",
    "tabs",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CMP"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "icons": {
    "512": "build-icon.png"
  }
}